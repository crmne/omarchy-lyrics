#!/usr/bin/env python3
"""Fetch lyrics from LRCLIB as JSON.

Network layer for the crmne.lyrics Omarchy plugin. The shell plugin never talks
to the network itself; it runs this script and reads one JSON object from stdout.

LRCLIB (https://lrclib.net) is a free, open lyrics database with no account and
no API key. It serves plain lyrics and, for a lot of tracks, synced lyrics in
LRC format -- a timestamp per line -- which is what lets the reader follow the
song instead of guessing.

Two subcommands, deliberately dumb: `get` asks for an exact match on the
metadata MPRIS gave us, and `search` returns candidates. Choosing between those
candidates is the plugin's job, not this script's.
"""

import argparse
import hashlib
import json
import os
import re
import sys
import time
import urllib.error
import urllib.parse
import urllib.request
import zlib

VERSION = "1.0.0"
# LRCLIB asks clients to identify themselves rather than pose as a browser.
UA = "omarchy-lyrics/%s (https://github.com/crmne/omarchy-lyrics)" % VERSION
API = "https://lrclib.net/api"
CACHE_DIR = os.path.join(
    os.environ.get("XDG_CACHE_HOME", os.path.expanduser("~/.cache")),
    "omarchy", "lyrics")


# Everything that crosses a boundary has a ceiling: what LRCLIB sends, what it
# inflates to, and what this script prints for the shell to hold in memory.
# Real answers are a few kilobytes; these leave plenty of room above that.
MAX_RESPONSE_BYTES = 1024 * 1024
MAX_DECODED_BYTES = 4 * 1024 * 1024
MAX_RESULTS = 20
MAX_LYRICS_CHARS = 64 * 1024
MAX_FIELD_CHARS = 512
# Service.qml caps what it collects at the same figure, so keep them in step.
MAX_OUTPUT_BYTES = 2 * 1024 * 1024


class BlockedUrl(Exception):
    """A URL we will not fetch, whatever supplied it."""


class TooLarge(Exception):
    """A response bigger than any lyrics could need."""


# Every URL is built from the API base below, but a redirect can still point
# anywhere, so each hop is checked rather than trusted.
ALLOWED_URL = re.compile(
    r"^https://(?:[a-z0-9-]+\.)*lrclib\.net(?:/[^\s]*)?$", re.I)


def check_url(url):
    r"""Match the whole URL against a strict shape rather than parsing it.

    Picking a host out of a URL invites disagreement with whatever parser sees
    it next. `https://evil.example\@lrclib.net/` reads as ours to anything
    splitting on "@", while a browser treats the backslash as a separator and
    goes to evil.example. There is no authority to misread here: userinfo,
    backslashes, ports and whitespace all fail the match outright.
    """
    if not ALLOWED_URL.match(str(url or "")):
        raise BlockedUrl("refusing to fetch %s" % (url or "an empty URL"))
    return url


class GuardedRedirects(urllib.request.HTTPRedirectHandler):
    """Re-checks every hop: an allowed host may still redirect anywhere."""

    def redirect_request(self, req, fp, code, msg, headers, newurl):
        check_url(newurl)
        return super().redirect_request(req, fp, code, msg, headers, newurl)


OPENER = urllib.request.build_opener(GuardedRedirects)


def read_limited(response):
    """Read a response body, refusing it before it can grow past the limits.

    Both the bytes on the wire and what gzip expands them to are bounded, so
    a small compressed body cannot inflate into something that will not fit.
    """
    length = (response.headers.get("Content-Length") or "").strip()
    if length.isdigit() and int(length) > MAX_RESPONSE_BYTES:
        raise TooLarge("LRCLIB sent a response too large to be lyrics")
    raw = response.read(MAX_RESPONSE_BYTES + 1)
    if len(raw) > MAX_RESPONSE_BYTES:
        raise TooLarge("LRCLIB sent a response too large to be lyrics")
    encoding = (response.headers.get("Content-Encoding") or "").strip().lower()
    if encoding == "gzip":
        inflater = zlib.decompressobj(zlib.MAX_WBITS | 16)
        try:
            raw = inflater.decompress(raw, MAX_DECODED_BYTES + 1)
        except zlib.error as exc:
            raise ValueError("LRCLIB sent a damaged response: %s" % exc)
        if len(raw) > MAX_DECODED_BYTES or inflater.unconsumed_tail:
            raise TooLarge("LRCLIB sent a response too large to be lyrics")
    elif encoding not in ("", "identity"):
        raise ValueError("LRCLIB sent an unexpected %s response" % encoding)
    return raw


def fetch(path, params, timeout=15, missing_ok=False):
    """GET an LRCLIB endpoint and return the decoded JSON.

    With `missing_ok`, a 404 returns None: LRCLIB answers "nobody has
    transcribed this track" with 404, which is an ordinary outcome.
    """
    url = API + path + "?" + urllib.parse.urlencode(
        {k: v for k, v in params.items() if v not in (None, "")})
    request = urllib.request.Request(check_url(url), headers={
        "User-Agent": UA, "Accept": "application/json", "Accept-Encoding": "gzip"})
    try:
        with OPENER.open(request, timeout=timeout) as response:
            raw = read_limited(response)
    except urllib.error.HTTPError as exc:
        # 404 is "nobody has transcribed this", 400 is "that is not a question
        # I can answer". Neither is a fault worth putting in front of someone.
        if missing_ok and exc.code in (400, 404):
            return None
        raise
    return json.loads(raw.decode("utf-8", "replace"))


def cached(key, ttl, produce):
    path = os.path.join(CACHE_DIR, hashlib.sha1(key.encode()).hexdigest() + ".json")
    try:
        # Entries are this script's own output, but one written before the
        # limits existed could be any size, so an oversized one is refetched.
        if (time.time() - os.path.getmtime(path) < ttl
                and os.path.getsize(path) <= MAX_OUTPUT_BYTES):
            with open(path, encoding="utf-8") as handle:
                return json.load(handle)
    except (OSError, ValueError):
        pass
    payload = produce()
    try:
        os.makedirs(CACHE_DIR, exist_ok=True)
        with open(path, "w", encoding="utf-8") as handle:
            json.dump(payload, handle)
    except OSError:
        pass
    return payload


def text(value, limit):
    """A string field from the API, cut down to `limit` characters.

    Lyrics are cut at the last line break that fits, so a truncated song ends on
    a whole line rather than halfway through a word.
    """
    value = value if isinstance(value, str) else ""
    if len(value) <= limit:
        return value
    value = value[:limit]
    newline = value.rfind("\n")
    return value[:newline] if newline > 0 else value


def number(value):
    return value if isinstance(value, (int, float)) and not isinstance(value, bool) else 0


def shape(record):
    if not isinstance(record, dict):
        return None
    return {
        "id": number(record.get("id")),
        "artist": text(record.get("artistName"), MAX_FIELD_CHARS),
        "track": text(record.get("trackName"), MAX_FIELD_CHARS),
        "album": text(record.get("albumName"), MAX_FIELD_CHARS),
        "duration": number(record.get("duration")),
        "instrumental": bool(record.get("instrumental")),
        "synced": text(record.get("syncedLyrics"), MAX_LYRICS_CHARS),
        "plain": text(record.get("plainLyrics"), MAX_LYRICS_CHARS),
    }


def encode(payload):
    """Serialise the payload, dropping the lowest-ranked search results until it
    fits the output limit. A single record always fits: its fields are capped."""
    payload = dict(payload)
    if isinstance(payload.get("result"), dict):
        payload["result"] = shape_output(payload["result"])
    if isinstance(payload.get("results"), list):
        payload["results"] = [shape_output(r) for r in payload["results"][:MAX_RESULTS]
                              if isinstance(r, dict)]
    while True:
        encoded = json.dumps(payload)
        if len(encoded) < MAX_OUTPUT_BYTES or not payload.get("results"):
            return encoded
        payload["results"] = payload["results"][:-1]


def shape_output(record):
    # Re-apply the field limits to what is about to be printed, whether it
    # came from the network or from a cache entry written by an older version.
    return shape({
        "id": record.get("id"), "artistName": record.get("artist"),
        "trackName": record.get("track"), "albumName": record.get("album"),
        "duration": record.get("duration"), "instrumental": record.get("instrumental"),
        "syncedLyrics": record.get("synced"), "plainLyrics": record.get("plain"),
    })


def cmd_get(args):
    # /api/get needs both names and answers 400 without them. Browsers playing a
    # video report a title and no artist, which is not an error worth showing
    # anyone: there is simply no exact match to ask for.
    if not args.artist.strip() or not args.title.strip():
        return {"ok": True, "result": None}

    def produce():
        record = fetch("/get", {
            "artist_name": args.artist,
            "track_name": args.title,
            "album_name": args.album,
            "duration": int(args.duration) if args.duration else None,
        }, missing_ok=True)
        return {"result": shape(record)}

    key = "get:%s|%s|%s|%s" % (args.artist, args.title, args.album, args.duration or "")
    payload = produce() if args.no_cache else cached(key, args.ttl, produce)
    return {"ok": True, **payload}


def cmd_search(args):
    def produce():
        records = fetch("/search", {
            "artist_name": args.artist,
            "track_name": args.title,
        }, missing_ok=True) or []
        if not isinstance(records, list):
            raise ValueError("LRCLIB sent an unexpected search response")
        # Only candidates that actually carry words are worth ranking, and
        # LRCLIB ranks them already, so the first few are the ones that matter.
        results = [shape(r) for r in records[:MAX_RESULTS]]
        return {"results": [r for r in results if r and (r["synced"] or r["plain"] or r["instrumental"])]}

    key = "search:%s|%s" % (args.artist, args.title)
    payload = produce() if args.no_cache else cached(key, args.ttl, produce)
    return {"ok": True, **payload}


def main():
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("--no-cache", action="store_true")
    parser.add_argument("--ttl", type=int, default=30 * 86400)
    sub = parser.add_subparsers(dest="command", required=True)

    get = sub.add_parser("get", help="exact lookup for one track")
    get.add_argument("--artist", required=True)
    get.add_argument("--title", required=True)
    get.add_argument("--album", default="")
    get.add_argument("--duration", type=float, default=0)

    search = sub.add_parser("search", help="candidates for an artist and title")
    search.add_argument("--artist", required=True)
    search.add_argument("--title", required=True)

    args = parser.parse_args()
    handlers = {"get": cmd_get, "search": cmd_search}
    try:
        payload = handlers[args.command](args)
    except BlockedUrl as exc:
        payload = {"ok": False, "code": "blocked", "error": str(exc)}
    except TooLarge as exc:
        payload = {"ok": False, "code": "too_large", "error": str(exc)}
    except urllib.error.HTTPError as exc:
        payload = {"ok": False, "code": "http", "error": "LRCLIB returned HTTP %d" % exc.code}
    except urllib.error.URLError as exc:
        payload = {"ok": False, "code": "network", "error": "cannot reach LRCLIB: %s" % exc.reason}
    except ValueError as exc:
        payload = {"ok": False, "code": "parse", "error": str(exc)}
    except Exception as exc:
        payload = {"ok": False, "code": "internal", "error": "%s: %s" % (type(exc).__name__, exc)}
    sys.stdout.write(encode(payload))
    sys.stdout.write("\n")
    return 0 if payload.get("ok") else 1


if __name__ == "__main__":
    sys.exit(main())
